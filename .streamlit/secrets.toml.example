# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Streamlit Community Cloud, paste the contents into App Settings > Secrets.
# This file should NEVER be committed to git.

# Define each of your leagues as a section under [leagues]
# The key (e.g. "espn_redraft") is used internally; "name" is what shows in the dropdown.

[leagues.espn_redraft]
name = "ESPN Redraft 2025"
platform = "ESPN"
league_id = 123456
year = 2025
espn_s2 = "your_espn_s2_cookie_value"
swid = "{your-swid-cookie-value}"
type = "redraft"

[leagues.espn_dynasty]
name = "ESPN Dynasty"
platform = "ESPN"
league_id = 654321
year = 2025
espn_s2 = "your_espn_s2_cookie_value"
swid = "{your-swid-cookie-value}"
type = "dynasty"

[leagues.sleeper_dynasty]
name = "Sleeper Dynasty"
platform = "Sleeper"
league_id = "your_sleeper_league_id"
type = "dynasty"

[leagues.sleeper_redraft]
name = "Sleeper Redraft"
platform = "Sleeper"
league_id = "your_sleeper_league_id"
type = "redraft"
