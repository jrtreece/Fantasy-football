# ESPN private league credentials
# Get these from your browser cookies after logging into ESPN Fantasy
# In Chrome: DevTools > Application > Cookies > espn.com
ESPN_S2=your_espn_s2_cookie_value
ESPN_SWID={your-swid-value}

# ESPN League settings
ESPN_LEAGUE_ID=123456
ESPN_YEAR=2025

# Sleeper League ID (found in the URL of your Sleeper league)
SLEEPER_LEAGUE_ID=your_sleeper_league_id
